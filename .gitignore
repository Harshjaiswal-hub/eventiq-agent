# EventIQ Agent — Git Ignore Rules

# Environment & Secrets (NEVER commit these)
.env
*.env
.env.local
.env.production

# Database files (contain real user data)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
env/
.venv/
.env/
ENV/

# Logs (generated at runtime)
logs/
*.log

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Screenshots / generated images (not source code)
*.png
*.jpg
*.jpeg

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo

# Backup files
backups/
*.bak
*.backup
eventiq_test_restore.db
