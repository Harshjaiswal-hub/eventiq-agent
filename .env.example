# ============================================================
# EventIQ Agent — Environment Configuration Template
# ============================================================
# 1. Copy this file to .env:  copy .env.example .env
# 2. Set every value marked <CHANGE THIS> before first deployment.
# 3. Never commit .env to version control — it is in .gitignore.
# ============================================================

# ── Server ─────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
DEBUG=False

# ── Database ───────────────────────────────────────────────
# Absolute or relative path to the SQLite database file.
DATABASE_PATH=./eventiq.db

# ── Security ───────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<CHANGE THIS — generate a 32-byte random hex string>

# Comma-separated list of allowed CORS origins (no wildcard).
# Change to your company's internal domain for production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ALLOWED_ORIGINS=https://analytics.yourcompany.com

# Set to True when deploying behind HTTPS (adds Secure cookie flag + HSTS header).
SECURE_COOKIES=False
# SECURE_COOKIES=True

# ── Initial Account Passwords ──────────────────────────────
# These passwords are ONLY used during first-time database initialization.
# If the database already has users, these values are ignored.
# IMPORTANT: Set all four to strong, unique passwords before first deployment.
# After first run, change passwords through the admin interface or directly
# in the database — these env vars have no effect on existing accounts.

INITIAL_ADMIN_PASSWORD=<CHANGE THIS>
INITIAL_EVALUATOR_PASSWORD=<CHANGE THIS>
INITIAL_LEAD_CC_PASSWORD=<CHANGE THIS>
INITIAL_LEAD_CN_PASSWORD=<CHANGE THIS>

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/eventiq.log

# ── Backup ─────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETAIN=7

# ── Optional LLM API Keys ──────────────────────────────────
# The system uses a fully deterministic local multi-agent coordinator by default.
# Uncomment and set only if you want to enable LLM-enhanced chat responses.
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
